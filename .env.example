# === Contoh Environment Variables SIM Porseni ===
# Salin file ini menjadi .env lalu isi sesuai lingkungan Anda.

# Koneksi MongoDB.
# - Lokal (development): mongodb://localhost:27017
# - Produksi (mis. Vercel): gunakan MongoDB Atlas, contoh:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Nama database
DB_NAME=porseni_db

# URL publik aplikasi (frontend memanggil {NEXT_PUBLIC_BASE_URL}/api)
# Lokal: http://localhost:3000
# Produksi: https://domain-anda.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Asal (origin) yang diizinkan untuk CORS. * = semua.
CORS_ORIGINS=*
